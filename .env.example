OPENAI_API_KEY=sk-pega-aqui-tu-clave
# Opcional: modelo para extraer las visitas del texto
# EXTRACTION_MODEL=gpt-4o-mini

# --- WhatsApp (Whapi.Cloud) ---
# Token del canal (panel de Whapi). En local el webhook necesita un túnel público (ngrok, cloudflared) o se prueba con curl.
WHAPI_TOKEN=pega-aqui-el-token-del-canal
# Celulares de administradores que piden el resumen por WhatsApp (separados por coma), ej. 0991234567,0987654321
ADMIN_TELEFONOS=
WEBHOOK_TOKEN=otra-clave-aleatoria-para-el-webhook

# --- Base de datos ---
# Vacío = SQLite local (bitacora.db). Para PostgreSQL: postgresql://usuario:clave@servidor:5432/bitacora
# DATABASE_URL=

# --- Acceso inicial: solo se usa si todavía NO existe ningún usuario ---
ADMIN_USUARIO=admin
ADMIN_PASSWORD=pon-una-clave-temporal-larga
# Horas que dura una sesión abierta, y COOKIE_SECURE=1 cuando el sitio se sirva por HTTPS
# SESION_HORAS=12
# COOKIE_SECURE=0

# Una casa impaga no puede recibir visitas (1 = activado, 0 = desactivado)
# BLOQUEO_POR_MORA=1
