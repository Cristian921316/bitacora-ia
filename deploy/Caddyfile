# Caddy: HTTPS automático (Let's Encrypt) y proxy hacia la app.
# {$DOMINIO} viene del archivo .env (ej. bitacora.midominio.com)
{$DOMINIO} {
	encode zstd gzip

	# El webhook de WhatsApp (/api/whatsapp/webhook) queda público porque Whapi llama desde internet.
	# Lo protege el secreto WEBHOOK_TOKEN de la URL (la app rechaza cualquier llamada sin él) y solo acepta POST.
	@webhook_no_post {
		path /api/whatsapp/webhook
		not method POST
	}
	respond @webhook_no_post 405

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:8000
}
