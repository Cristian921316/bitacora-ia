# Copia este archivo como ".env" EN EL SERVIDOR y completa los valores. Nunca lo subas a git.
# Para generar claves seguras:  openssl rand -hex 24

# Con esto basta escribir "docker compose up -d" (sin indicar el archivo)
COMPOSE_FILE=docker-compose.prod.yml

# Dirección pública (el DNS debe apuntar a la IP del servidor)
DOMINIO=bitacora.tu-dominio.com

OPENAI_API_KEY=sk-pega-aqui-tu-clave

# Primer administrador: solo se usa si todavía no existe ningún usuario. Debe cambiar la clave al ingresar.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=pon-una-clave-temporal-larga

# WhatsApp (Evolution API)
EVOLUTION_APIKEY=genera-con-openssl-rand-hex-24
WEBHOOK_TOKEN=genera-con-openssl-rand-hex-16
EVOLUTION_DB_PASSWORD=genera-con-openssl-rand-hex-16
EVOLUTION_INSTANCE=bitacora

# Opcionales
# SESION_HORAS=12
# BLOQUEO_POR_MORA=1
